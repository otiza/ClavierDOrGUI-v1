# .gitignore for .NET MAUI project (Windows + cross-platform)
# Keep this file at the repository root

# Build / output
bin/
obj/
**/bin/
**/obj/
publish/
artifacts/

# Visual Studio / Rider
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.iml

# Rider
.idea/
*.DotSettings.user

# NuGet
packages/
*.nupkg
project.lock.json
project.fragment.lock.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs, temporary files
*.log
*.tmp
*.temp

# Android / Java
local.properties
*.keystore
.gradle/

# macOS
__MACOSX/

# IDE/editor swap files
*.swp
*.swo

# Certificate / publish
*.Publish.xml

# SQLite DB files (local app data) - typically not committed
*.db

# Do NOT ignore CSV question data - keep it in the repo
!Data/
!Data/*.csv

# Keep explicit exceptions if needed (don't ignore these files)
!.gitattributes

