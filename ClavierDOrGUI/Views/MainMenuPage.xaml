<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClavierDOrGUI.Views.MainMenuPage"
             Title="Clavier d'Or">

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">
        <Label Text="Clavier d'Or" FontSize="28" HorizontalOptions="Center" />

        <Button Text="Nouvelle partie" Command="{Binding NewGameCommand}" />
        <Button Text="Reprendre" Command="{Binding ResumeGameCommand}" />
        <Button Text="Historique" Command="{Binding HistoryCommand}" />
        <Button Text="Quitter" Command="{Binding QuitCommand}" />
    </VerticalStackLayout>

</ContentPage>

